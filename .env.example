# Server Port (Injected automatically by Railway in production, default 8000)
PORT=8000

# AI-MultiSense Backend Configuration
THERMAL_MODEL_PATH=models/thermal/best.pt
MAX_UPLOAD_SIZE_MB=100

# Persistent Storage & Database Configuration
# Local Development:
# DATABASE_URL=sqlite:///./data/surveillance.db
# UPLOAD_DIR=data/uploads
# SNAPSHOTS_DIR=data/snapshots
# Railway Production (with Persistent Volume mounted at /app/data):
DATABASE_URL=sqlite:////app/data/surveillance.db
UPLOAD_DIR=/app/data/uploads
SNAPSHOTS_DIR=/app/data/snapshots

# Allowed CORS Origins (comma-separated or JSON array)
CORS_ORIGINS=["https://ai-multisense.vercel.app","http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
